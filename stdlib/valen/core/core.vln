package valen.core;

// --- Option ---

pub enum Option<T> {
    Some(value: T),
    None,
}

// --- Result ---

pub enum Result<T, E> {
    Ok(value: T),
    Err(error: E),
}

// --- Eq trait ---

pub trait Eq {
    fn eq(self, other: Self) -> Bool;
}

// --- Hash trait ---

pub trait Hash {
    fn hash(self) -> Int;
}

// --- Display trait ---

pub trait Display {
    fn display(self) -> String;
}

// --- Clone trait ---

pub trait Clone {
    fn clone(self) -> Self;
}

// --- Error trait ---

pub trait Error {
    fn message(self) -> String;
}

// --- Iterator trait ---

pub trait Iterator<T> {
    fn next(mut self) -> Option<T>;
    fn forEach(mut self, f: fn(T) -> Unit);
    fn count(mut self) -> Int;
    fn any(mut self, predicate: fn(T) -> Bool) -> Bool;
    fn all(mut self, predicate: fn(T) -> Bool) -> Bool;
    fn find(mut self, predicate: fn(T) -> Bool) -> Option<T>;
}

// --- Conversion traits ---

pub trait Into<T> {
    fn into(self) -> T;
}

pub trait From<T> {
    fn from(value: T) -> Self;
}

pub trait TryInto<T> {
    fn tryInto(self) -> Result<T, String>;
}

pub trait TryFrom<T> {
    fn tryFrom(value: T) -> Result<Self, String>;
}

// --- Default trait ---

pub trait Default {
    fn default() -> Self;
}

// --- IntoIterator trait ---

pub trait IntoIterator<T> {
    fn intoIter(self) -> Iterator<T>;
}

// --- Index trait ---

pub trait Index<Idx> {
    type Output;
    fn index(self, idx: Idx) -> Self;
}

// --- ToString trait ---

pub trait ToString {
    fn toString(self) -> String;
}

// --- Operator traits (arithmetic) ---

pub trait Add<Rhs> {
    type Output;
    fn add(self, rhs: Rhs) -> Self;
}

pub trait Sub<Rhs> {
    type Output;
    fn sub(self, rhs: Rhs) -> Self;
}

pub trait Mul<Rhs> {
    type Output;
    fn mul(self, rhs: Rhs) -> Self;
}

pub trait Div<Rhs> {
    type Output;
    fn div(self, rhs: Rhs) -> Self;
}

pub trait Rem<Rhs> {
    type Output;
    fn rem(self, rhs: Rhs) -> Self;
}

// --- Operator traits (unary) ---

pub trait Neg {
    type Output;
    fn neg(self) -> Self;
}

pub trait Not {
    type Output;
    fn not(self) -> Self;
}

// --- Comparison traits ---

pub trait Ord {
    fn cmp(self, rhs: Self) -> Int;
}

// --- Numeric conversion methods ---

impl Int {
    fn toLong(self) -> Long { 0L }
    fn toFloat(self) -> Float { 0.0f }
    fn toDouble(self) -> Double { 0.0 }
}

impl Long {
    fn toInt(self) -> Int { 0 }
    fn toFloat(self) -> Float { 0.0f }
    fn toDouble(self) -> Double { 0.0 }
}

impl Float {
    fn toInt(self) -> Int { 0 }
    fn toLong(self) -> Long { 0L }
    fn toDouble(self) -> Double { 0.0 }
}

impl Double {
    fn toInt(self) -> Int { 0 }
    fn toLong(self) -> Long { 0L }
    fn toFloat(self) -> Float { 0.0f }
}

// --- Ordering ---

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

// --- Pair ---

pub data class Pair<A, B>(pub first: A, pub second: B);

// --- Option methods ---

impl Option<T> {
    fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self {
            Option::Some(v) => Option::Some(f(v)),
            Option::None => Option::None,
        }
    }

    fn flatMap<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            Option::Some(v) => f(v),
            Option::None => Option::None,
        }
    }

    fn unwrapOr(self, default: T) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => default,
        }
    }

    fn filter(self, predicate: fn(T) -> Bool) -> Option<T> {
        match self {
            Option::Some(v) => if predicate(v) { Option::Some(v) } else { Option::None },
            Option::None => Option::None,
        }
    }

    fn isSome(self) -> Bool {
        match self {
            Option::Some(v) => true,
            Option::None => false,
        }
    }

    fn isNone(self) -> Bool {
        match self {
            Option::Some(v) => false,
            Option::None => true,
        }
    }
}

// --- Result methods ---

impl Result<T, E> {
    fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Result::Ok(v) => Result::Ok(f(v)),
            Result::Err(e) => Result::Err(e),
        }
    }

    fn mapErr<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Result::Ok(v) => Result::Ok(v),
            Result::Err(e) => Result::Err(f(e)),
        }
    }

    fn flatMap<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok(v) => f(v),
            Result::Err(e) => Result::Err(e),
        }
    }

    fn unwrapOr(self, default: T) -> T {
        match self {
            Result::Ok(v) => v,
            Result::Err(e) => default,
        }
    }

    fn isOk(self) -> Bool {
        match self {
            Result::Ok(v) => true,
            Result::Err(e) => false,
        }
    }

    fn isErr(self) -> Bool {
        match self {
            Result::Ok(v) => false,
            Result::Err(e) => true,
        }
    }
}

// --- Range ---

pub data class Range<T>(
    pub start: T,
    pub end: T,
    pub inclusive: Bool,
);

// --- JavaException ---

pub data class JavaException(
    pub message: String,
    pub class_name: String,
);

impl Error for JavaException {
    fn message(self) -> String {
        self.message
    }
}
