package valen.core;

// --- Option ---

pub enum Option<T> {
    Some(value: T),
    None,
}

// --- Result ---

pub enum Result<T, E> {
    Ok(value: T),
    Err(error: E),
}

// --- Eq trait ---

pub trait Eq {
    fn eq(self, other: Self) -> Bool;
}

// --- Hash trait ---

pub trait Hash {
    fn hash(self) -> Int;
}

// --- Debug trait ---

pub trait Debug {
    fn fmt(self) -> String;
}

// --- Clone trait ---

pub trait Clone {
    fn clone(self) -> Self;
}

// --- Error trait ---

pub trait Error {
    fn message(self) -> String;
}

// --- Iterator trait ---

pub trait Iterator<T> {
    fn next(mut self) -> Option<T>;
}

// --- Operator traits (arithmetic) ---

pub trait Add<Rhs> {
    type Output;
    fn add(self, rhs: Rhs) -> Self;
}

pub trait Sub<Rhs> {
    type Output;
    fn sub(self, rhs: Rhs) -> Self;
}

pub trait Mul<Rhs> {
    type Output;
    fn mul(self, rhs: Rhs) -> Self;
}

pub trait Div<Rhs> {
    type Output;
    fn div(self, rhs: Rhs) -> Self;
}

pub trait Rem<Rhs> {
    type Output;
    fn rem(self, rhs: Rhs) -> Self;
}

// --- Operator traits (unary) ---

pub trait Neg {
    type Output;
    fn neg(self) -> Self;
}

pub trait Not {
    type Output;
    fn not(self) -> Self;
}

// --- Comparison traits ---

pub trait Ord {
    fn cmp(self, rhs: Self) -> Int;
}

// --- Range ---

pub data class Range<T>(
    pub start: T,
    pub end: T,
    pub inclusive: Bool,
);

// --- JavaException ---

pub data class JavaException(
    pub message: String,
    pub class_name: String,
);

impl Error for JavaException {
    fn message(self) -> String {
        self.message
    }
}
