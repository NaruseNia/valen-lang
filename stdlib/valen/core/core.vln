package valen.core;

// --- Option ---

pub enum Option<T> {
    Some(value: T),
    None,
}

// --- Result ---

pub enum Result<T, E> {
    Ok(value: T),
    Err(error: E),
}

// --- Eq trait ---

pub trait Eq {
    fn eq(self, other: Self) -> Bool;
}

// --- Hash trait ---

pub trait Hash {
    fn hash(self) -> Int;
}

// --- Debug trait ---

pub trait Debug {
    fn fmt(self) -> String;
}

// --- Clone trait ---

pub trait Clone {
    fn clone(self) -> Self;
}

// --- Error trait ---

pub trait Error {
    fn message(self) -> String;
}

// --- Iterator trait ---

pub trait Iterator<T> {
    fn next(mut self) -> Option<T>;
}

// --- Range ---

pub data class Range<T>(
    pub start: T,
    pub end: T,
    pub inclusive: Bool,
);

// --- JavaException ---

pub data class JavaException(
    pub message: String,
    pub class_name: String,
);

impl Error for JavaException {
    fn message(self) -> String {
        self.message
    }
}
