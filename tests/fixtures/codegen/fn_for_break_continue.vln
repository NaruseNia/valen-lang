package com.example;

pub class BreakCont {
    fn findFirstEven(self) -> Int {
        let mut result = 0;
        for i in 0..100 {
            if i % 2 != 0 {
                continue;
            }
            if i > 10 {
                break;
            }
            result = i;
        }
        result
    }
}
