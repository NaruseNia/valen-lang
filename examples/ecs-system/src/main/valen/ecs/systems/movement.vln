package ecs.systems;

import java.util.ArrayList;

/// Applies velocity to position using if-let for clean Option handling.
pub class MovementSystem {}

impl System for MovementSystem {
    fn update(self, world: World, dt: Float) -> Unit {
        let required = ArrayList();
        required.add("Position");
        required.add("Velocity");
        let results = world.query(QueryFilter::All(components = required));

        let mut i = 0;
        while i < results.size() {
            let qr = results.get(i);
            if let Some(pos) = world.getComponent(qr.entity, "Position") {
                if let Some(vel) = world.getComponent(qr.entity, "Velocity") {
                    let newPos = Position(
                        x = pos.x + vel.dx * dt,
                        y = pos.y + vel.dy * dt,
                    );
                    world.addComponent(qr.entity, "Position", newPos);
                    println(f"  moved {qr.entity.id} to ({newPos.x}, {newPos.y})");
                }
            }
            i = i + 1;
        }
    }
}
