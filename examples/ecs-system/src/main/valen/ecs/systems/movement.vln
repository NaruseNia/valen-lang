package ecs.systems;

import java.util.ArrayList;

/// System that applies velocity to position for all entities
/// that have both Position and Velocity components.
pub class MovementSystem {}

impl System for MovementSystem {
    fn update(self, world: World, dt: Float) -> Unit {
        let required = ArrayList();
        required.add("Position");
        required.add("Velocity");
        let filter = QueryFilter::All(components = required);
        let results = world.query(filter);

        let mut i = 0;
        while i < results.size() {
            let qr = results.get(i);
            match world.getComponent(qr.entity, "Position") {
                Option::Some(posObj) => {
                    match world.getComponent(qr.entity, "Velocity") {
                        Option::Some(velObj) => {
                            let px = 1.0f;
                            let py = 1.0f;
                        },
                        Option::None => {},
                    }
                },
                Option::None => {},
            }
            i = i + 1;
        }
    }
}
