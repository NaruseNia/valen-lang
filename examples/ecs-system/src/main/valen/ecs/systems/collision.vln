package ecs.systems;

import java.util.ArrayList;

/// Simple AABB collision detection system.
/// Demonstrates let-else to flatten deeply nested Option matching.
pub class CollisionSystem {
    /// AABB overlap test — flattened from 4-deep match nest using let-else.
    fn checkOverlap(world: World, a: Entity, b: Entity) -> Bool {
        let Option::Some(posA) = world.getComponent(a, "Position") else { return false; };
        let Option::Some(posB) = world.getComponent(b, "Position") else { return false; };
        let Option::Some(boxA) = world.getComponent(a, "BoundingBox") else { return false; };
        let Option::Some(boxB) = world.getComponent(b, "BoundingBox") else { return false; };

        let halfWA = boxA.width / 2.0f;
        let halfHA = boxA.height / 2.0f;
        let halfWB = boxB.width / 2.0f;
        let halfHB = boxB.height / 2.0f;

        let overlapX = posA.x - halfWA < posB.x + halfWB
            && posA.x + halfWA > posB.x - halfWB;
        let overlapY = posA.y - halfHA < posB.y + halfHB
            && posA.y + halfHA > posB.y - halfHB;

        overlapX && overlapY
    }
}

impl System for CollisionSystem {
    fn update(self, world: World, dt: Float) -> Unit {
        let required = ArrayList();
        required.add("Position");
        required.add("BoundingBox");
        let results = world.query(QueryFilter::All(components = required));

        let mut i = 0;
        while i < results.size() {
            let a = results.get(i);
            let mut j = i + 1;
            while j < results.size() {
                let b = results.get(j);
                if CollisionSystem::checkOverlap(world, a.entity, b.entity) {
                    println(f"  collision: {a.entity.id} <-> {b.entity.id}");
                    world.events.push(Event::Collision(a = a.entity, b = b.entity));
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }
}
