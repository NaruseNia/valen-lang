package ecs.systems;

import java.util.ArrayList;

/// Rendering system that collects visible entities and prints them.
pub class RenderSystem {
    fn collectRenderables(world: World) -> ArrayList {
        let required = ArrayList();
        required.add("Position");
        required.add("Sprite");
        world.query(QueryFilter::All(components = required))
    }
}

impl System for RenderSystem {
    fn update(self, world: World, dt: Float) -> Unit {
        let renderables = RenderSystem::collectRenderables(world);
        let mut i = 0;
        while i < renderables.size() {
            let qr = renderables.get(i);
            if let Some(pos) = world.getComponent(qr.entity, "Position") {
                if let Some(sprite) = world.getComponent(qr.entity, "Sprite") {
                    println(f"  render [{sprite.name}] at ({pos.x}, {pos.y}) layer={sprite.layer}");
                }
            }
            i = i + 1;
        }
    }
}
