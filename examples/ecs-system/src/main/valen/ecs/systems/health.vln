package ecs.systems;

import java.util.ArrayList;

/// Processes damage events and updates health components.
/// Emits EntityDied when health reaches zero.
pub class HealthSystem {
    fn applyDamage(world: World, target: Entity, amount: Int) -> Unit {
        if let Some(health) = world.getComponent(target, "Health") {
            let newCurrent = health.current - amount;
            if newCurrent <= 0 {
                world.addComponent(target, "Health", Health(current = 0, max = health.max));
                world.events.push(Event::EntityDied(entity = target));
                println(f"  entity {target.id} died (took {amount} damage)");
            } else {
                world.addComponent(target, "Health", Health(current = newCurrent, max = health.max));
                println(f"  entity {target.id} hp: {newCurrent}/{health.max}");
            }
        }
    }
}

impl System for HealthSystem {
    fn update(self, world: World, dt: Float) -> Unit {
        let events = world.drainEvents();
        let mut i = 0;
        while i < events.size() {
            if let Event::DamageTaken(target, amount) = events.get(i) {
                HealthSystem::applyDamage(world, target, amount);
            }
            i = i + 1;
        }
    }
}
