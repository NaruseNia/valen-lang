package ecs;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.HashSet;

/// Specifies which components an entity must have to match a query.
pub enum QueryFilter derives(Display) {
    All(components: ArrayList),
    Any(components: ArrayList),
    Exclude(components: ArrayList),
}

/// Result of a query: a matched entity and its component map.
pub data class QueryResult(pub entity: Entity, pub components: HashMap) derives(Eq);

/// Executes queries against the component registry.
pub class QueryEngine(pub registry: ComponentRegistry) {
    fn query(self, filter: QueryFilter) -> ArrayList {
        let results = ArrayList();
        match filter {
            .All(components) => self.queryAll(components, results),
            .Any(components) => self.queryAny(components, results),
            .Exclude(components) => self.queryExclude(components, results),
        }
        results
    }

    fn queryAll(self, componentNames: ArrayList, results: ArrayList) -> Unit {
        if componentNames.size() == 0 {
            return;
        }
        let firstName = componentNames.get(0);
        let candidates = self.registry.getStorage(firstName).entities();

        let mut i = 0;
        while i < candidates.size() {
            let entityId = candidates.get(i);
            let entity = Entity(id = entityId);
            let mut matches = true;
            let mut j = 1;
            while j < componentNames.size() {
                if !self.registry.hasComponent(entity, componentNames.get(j)) {
                    matches = false;
                }
                j = j + 1;
            }
            if matches {
                let comps = HashMap();
                let mut k = 0;
                while k < componentNames.size() {
                    let name = componentNames.get(k);
                    if let Some(comp) = self.registry.getComponent(entity, name) {
                        comps.put(name, comp);
                    }
                    k = k + 1;
                }
                results.add(QueryResult(entity = entity, components = comps));
            }
            i = i + 1;
        }
    }

    fn queryAny(self, componentNames: ArrayList, results: ArrayList) -> Unit {
        let seen = HashSet();
        let mut i = 0;
        while i < componentNames.size() {
            let name = componentNames.get(i);
            let entityIds = self.registry.getStorage(name).entities();
            let mut j = 0;
            while j < entityIds.size() {
                let entityId = entityIds.get(j);
                if !seen.contains(entityId) {
                    seen.add(entityId);
                    let entity = Entity(id = entityId);
                    let comps = HashMap();
                    let mut k = 0;
                    while k < componentNames.size() {
                        let cn = componentNames.get(k);
                        if let Some(comp) = self.registry.getComponent(entity, cn) {
                            comps.put(cn, comp);
                        }
                        k = k + 1;
                    }
                    results.add(QueryResult(entity = entity, components = comps));
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    fn queryExclude(self, excludedNames: ArrayList, results: ArrayList) -> Unit {
        let allEntities = HashSet();
        let iter = self.registry.storages.keySet().iterator();
        while iter.hasNext() {
            let key = iter.next();
            let storage = self.registry.storages.get(key);
            let entityIds = storage.entities();
            let mut i = 0;
            while i < entityIds.size() {
                allEntities.add(entityIds.get(i));
                i = i + 1;
            }
        }

        let entityIter = allEntities.iterator();
        while entityIter.hasNext() {
            let entityId = entityIter.next();
            let entity = Entity(id = entityId);
            let mut excluded = false;
            let mut i = 0;
            while i < excludedNames.size() {
                if self.registry.hasComponent(entity, excludedNames.get(i)) {
                    excluded = true;
                }
                i = i + 1;
            }
            if !excluded {
                results.add(QueryResult(entity = entity, components = HashMap()));
            }
        }
    }
}
